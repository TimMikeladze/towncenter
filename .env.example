# The public origin of the site. Canonical URLs, the sitemap, robots.txt and
# the social cards are all absolute, so they need to know where the site lives.
# Unset, it falls back to Vercel's production hostname for the project, and
# then to the deployed default — preview deployments deliberately resolve to
# the production origin so a preview never advertises itself as canonical.
# NEXT_PUBLIC_SITE_URL=https://towncenter.example.com

# Umami analytics — entirely optional. Without NEXT_PUBLIC_UMAMI_WEBSITE_ID the
# tracker is never loaded and the app runs exactly as it does today.
# These are inlined at build time, so changing them needs a redeploy.

# The website's UUID from the Umami dashboard. The only required value.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Tracker script, or just the instance origin.
# Defaults to https://linesofcode-umami.vercel.app/script.js
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# Comma-separated hostnames allowed to report. Set this to keep Vercel preview
# deployments out of the numbers.
# NEXT_PUBLIC_UMAMI_DOMAINS=towncenter.example.com
